# ============================================================
# nobod.ai — Environment Variables (Template)
# ------------------------------------------------------------
# Kopiere diese Datei nach `.env.local` und fülle die Werte aus.
#   cp .env.local.example .env.local
#
# .env.local ist in .gitignore und wird NIE committet.
# Die produktiven Werte liegen im Vercel-Projekt unter
#   Settings → Environment Variables.
# ============================================================

# --- Supabase (Auth + Datenbank + Storage) -----------------
# Dashboard: https://supabase.com/dashboard/project/awmastpeybhlaiqqvace
# Settings → API → Project URL / anon public key
NEXT_PUBLIC_SUPABASE_URL=https://awmastpeybhlaiqqvace.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic Claude (Text-/Post-Generierung) -------------
# Console: https://console.anthropic.com → API Keys
# Verwendetes Modell im Code: claude-sonnet-4-20250514
ANTHROPIC_API_KEY=

# --- fal.ai (Bild-/Visual-Generierung) ---------------------
# Dashboard: https://fal.ai/dashboard/keys
FAL_KEY=

# --- Cron-Schutz (Vercel Cron → /api/cron/generate) --------
# Frei wählbares Secret; identisch in Vercel-ENV hinterlegen.
CRON_SECRET=

# --- Stripe (Zahlungen / Pläne) ----------------------------
# Dashboard: https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
# Price-IDs der drei kostenpflichtigen Pläne (Products → Pricing)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
